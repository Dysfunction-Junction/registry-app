rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(resource) {
      return request.auth != null && request.auth.uid == resource.data.createdBy;
    }
    function isOwnerOnCreate() {
      return request.auth != null && request.auth.uid == request.resource.data.createdBy;
    }

    match /registryItems/{itemId} {
      allow create: if isOwnerOnCreate();
      allow read, delete: if isOwner(resource);
      allow update: if isOwner(resource) && isOwnerOnCreate();
    }
    match /observations/{obsId} {
      allow create: if isOwnerOnCreate();
      allow read, delete: if isOwner(resource);
      allow update: if isOwner(resource) && isOwnerOnCreate();
    }
    match /alertDismissals/{dismissalId} {
      allow create: if isOwnerOnCreate();
      allow read, delete: if isOwner(resource);
      allow update: if isOwner(resource) && isOwnerOnCreate();
    }
    match /stagingItems/{itemId} {
      allow create: if isOwnerOnCreate();
      allow read, delete: if isOwner(resource);
      allow update: if isOwner(resource) && isOwnerOnCreate();
    }
    match /deviceSources/{sourceId} {
      allow create: if isOwnerOnCreate();
      allow read, delete: if isOwner(resource);
      allow update: if isOwner(resource) && isOwnerOnCreate();
    }
    match /suggestions/{suggestionId} {
      allow create: if isOwnerOnCreate();
      allow read, delete: if isOwner(resource);
      allow update: if isOwner(resource) && isOwnerOnCreate();
    }
    match /taskRankings/{rankingId} {
      allow create: if isOwnerOnCreate();
      allow read, delete: if isOwner(resource);
      allow update: if isOwner(resource) && isOwnerOnCreate();
    }
    match /coachDailyCounters/{counterId} {
      allow create: if isOwnerOnCreate();
      allow read, delete: if isOwner(resource);
      allow update: if isOwner(resource) && isOwnerOnCreate();
    }
    match /workflowSuggestions/{suggestionId} {
      allow create: if isOwnerOnCreate();
      allow read, delete: if isOwner(resource);
      allow update: if isOwner(resource) && isOwnerOnCreate();
    }
    match /workflows/{workflowId} {
      allow create: if isOwnerOnCreate();
      allow read, delete: if isOwner(resource);
      allow update: if isOwner(resource) && isOwnerOnCreate();
    }
    match /workflowRuns/{runId} {
      allow create: if isOwnerOnCreate();
      allow read, delete: if isOwner(resource);
      allow update: if false;
    }

    // 2nd Helpings (Oakridge Smokehouse Cafeteria Manager)
    match /second_helpings_users/{userId} {
      allow read, write: if true;
    }
    match /second_helpings_menu/{menuId} {
      allow read, write: if true;
    }
    match /second_helpings_catalog/{catalogId} {
      allow read, write: if true;
    }
    match /second_helpings_audit/{auditId} {
      allow read, write: if true;
    }
    // Procurement module (synced from oakridge-procurement export_matrix.py).
    // Without these, unmatched paths are denied: on-hand counts, par edits
    // and "Save PO to Cloud" fail silently and the app falls back to the
    // bundled JSON. Same open policy as the collections above (no Firebase
    // Auth in 2nd Helpings yet); tighten together when auth lands.
    match /second_helpings_procurement/{sku} {
      allow read, write: if true;
    }
    match /second_helpings_purchase_orders/{orderId} {
      allow read, create: if true;
    }
    match /second_helpings_meta/{metaId} {
      allow read, write: if true;
    }
  }
}
